# Baked into the static build at build time (Next.js NEXT_PUBLIC_* convention) — this frontend
# is a static export with no server at runtime, so there is nothing to read this at request
# time. Must be a URL the BROWSER can reach, never a Docker Compose service name like
# `http://api:3000` (that only resolves between containers, not from the user's machine).
#
# Default matches the backend API's own default port (backend/.env.example's PORT=3000, and
# docker-compose.yml's `api` service publishing ${API_PORT:-3000}:3000 to the host).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
