# For building the frontend directly (outside Docker). Under `docker compose build`, the
# root `.env`'s NEXT_PUBLIC_API_BASE_URL is used instead as a build ARG (this file is not
# read in that case).
#
# Baked into the static build at build time — no server exists at runtime to read this later.
# Must be a URL the browser can reach, never a Compose-internal name like `http://api:3000`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
