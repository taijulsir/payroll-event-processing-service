# For running the API/worker directly (outside Docker). Under `docker compose up`,
# docker-compose.yml's own `environment:` block supplies these instead (see ../.env.example).

# --- HTTP API ---
PORT=3000
NODE_ENV=development

# --- CORS ---
# Must be the browser-reachable frontend origin, never localhost on a VM.
FRONTEND_ORIGIN=http://localhost:3001

# --- PostgreSQL ---
# payroll:payroll is a local-only default — never reuse it for a real deployment.
DATABASE_URL=postgresql://payroll:payroll@localhost:5432/payroll?schema=public

# --- Redis / BullMQ ---
REDIS_HOST=localhost
REDIS_PORT=6379

# Simulated payroll provider (simulated-payroll-provider.ts) is deterministic — nothing to
# configure here.
