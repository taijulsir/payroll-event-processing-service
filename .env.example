# Consumed by docker-compose.yml's variable substitution — not read by the app directly (see
# backend/.env.example and frontend/.env.example). Copy to `.env`; every default below works
# for local `docker compose up --build` unchanged.

# PORT is the api container's internal listen port; API_PORT is the host port mapped to it.
# Keep them equal unless you have a specific reason not to.
PORT=3000
API_PORT=3000
FRONTEND_PORT=3001

# Browser-reachable frontend origin; becomes the API's CORS allowlist entry.
# VM example: FRONTEND_ORIGIN=http://169.58.101.185:3001
FRONTEND_ORIGIN=http://localhost:3001

# Browser-reachable API base URL, baked into the frontend's static build (build ARG — a
# rebuild is required after changing this, a restart is not).
# VM example: NEXT_PUBLIC_API_BASE_URL=http://169.58.101.185:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Redis port used both by the `redis` container itself and by api/worker to reach it. Not
# published to the host by default (see docker-compose.override.yml.example for local access).
REDIS_PORT=6379

# PostgreSQL credentials for the `postgres` container and migrate/api/worker's DATABASE_URL.
# Change POSTGRES_PASSWORD for any deployment reachable by anyone but you — this file is
# public. Only take effect on first init of an empty `postgres_data` volume.
POSTGRES_USER=payroll
POSTGRES_PASSWORD=payroll
POSTGRES_DB=payroll
