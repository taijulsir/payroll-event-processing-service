# Host-side port overrides consumed by docker-compose.yml's own variable substitution
# (`${POSTGRES_PORT:-5432}`, etc.) — NOT read by the application itself (see
# backend/.env.example for the application's own environment variables). Only needed if the
# default ports below already conflict with something else running on your machine; every
# variable here has a working default and this file can be copied to `.env` unchanged.

POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3000
